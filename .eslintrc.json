{
  "root": true,
  "env": {
    "browser": true,
    "node": true,
    "es6": true
  },
  "plugins": ["import", "@typescript-eslint", "react", "prettier"],
  "extends": [
    "airbnb",
    "airbnb/hooks",
    "next/core-web-vitals",
    "prettier",
    "airbnb-typescript"
  ],
  "rules": {
    "jsx-a11y/label-has-associated-control": [
      2,
      {
        "some": ["nesting", "id"]
      }
    ],
    "@typescript-eslint/indent": "off",
    "react/react-in-jsx-scope": "off",
    "@typescript-eslint/camelcase": "off",
    "@typescript-eslint/no-unused-vars": "warn",
    "react/jsx-props-no-spreading": "off",
    "react/require-default-props": "off",
    "no-console": "warn",
    "react/button-has-type": "off",
    "arrow-body-style": "off",
    "@typescript-eslint/no-use-before-define": "off",
    "prettier/prettier": [
      "error",
      {
        "endOfLine": "auto"
      }
    ],
    "react/function-component-definition": [
      2,
      {
        "namedComponents": ["function-declaration"]
      }
    ],
    "import/no-restricted-paths": [
      "error",
      {
        "zones": [
          {
            "target": "./src/shared",
            "from": [
              "./src/entities",
              "./src/features",
              "./src/widgets",
              "./src/views",
              "./src/app"
            ],
            "message": "shared는 의존성 화살표의 끝이라 어떤 레이어도 import할 수 없습니다. 상위 레이어가 필요하다면 그 파일은 shared 소속이 아닙니다."
          },
          {
            "target": "./src/entities",
            "from": [
              "./src/features",
              "./src/widgets",
              "./src/views",
              "./src/app"
            ],
            "message": "entities는 features/widgets/views/app을 import할 수 없습니다."
          },
          {
            "target": "./src/features",
            "from": ["./src/widgets", "./src/views", "./src/app"],
            "message": "features는 widgets/views/app을 import할 수 없습니다."
          },
          {
            "target": "./src/widgets",
            "from": ["./src/views", "./src/app"],
            "message": "widgets는 views/app을 import할 수 없습니다."
          },
          {
            "target": "./src/views",
            "from": ["./src/app"],
            "message": "views는 app을 import할 수 없습니다."
          }
        ]
      }
    ]
  },
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    },
    "project": "./tsconfig.json"
  },
  "ignorePatterns": ["build", "dist", "public"]
}
