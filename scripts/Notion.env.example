# Copy to repository root as .env.notion. Never commit the populated file.
# Create an INTERNAL integration in the TEAM workspace and grant it Read content.
# Connect only the required meeting pages/databases to that integration.
NOTION_TOKEN=

# Optional: configure ONE source ID for requests without a page link.
# This is a discovery default, not an API authorization boundary.
NOTION_DEFAULT_PAGE_ID=
NOTION_DEFAULT_DATABASE_ID=
